				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Drawry Encrypted Backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.poyal.drawry.backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>drawry</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.poyal.drawry.backup</string>
			</dict>
		</dict>
	</array>
